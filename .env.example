# Brutti Catalog production configuration (dedicated Brutti Supabase project ONLY).
# Both URL and public client key are REQUIRED. The app never falls back to demo.
# Do not use the Tumbooh project or put server-side/secret keys here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional approved enquiry address. Empty means public enquiries are disabled.
VITE_ENQUIRY_EMAIL=
