# Without these settings, the application uses labelled local demo data.
# Copy this file to .env.local. Never add a Supabase service-role/secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: force the local, unsecured demo even when Supabase is configured.
VITE_DEMO_MODE=false

# Optional approved business contact. Empty keeps public enquiries disabled.
# The contact action opens a mailto draft; it does not submit or store enquiries.
VITE_ENQUIRY_EMAIL=
